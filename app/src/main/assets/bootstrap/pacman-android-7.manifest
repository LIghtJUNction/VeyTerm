fallback_repository_url=https://github.com/LIghtJUNction/VeyTerm/releases/download/veyterm-native-20261026
aur_default=disabled
aur_build_user=ordinary-user
required_packages=pacman,paru,sudo,make,binutils,autoconf,automake,bison,flex,git,ca-certificates,termux-keyring,openssl,curl,zstd,fakeroot,proot,proot-distro,python,python-pip
required_runtime_files=etc/pacman.conf,etc/makepkg.conf,etc/pacman.d/gnupg,var/lib/pacman/sync,bin/pacman,bin/paru,bin/sudo,bin/proot,bin/proot-distro,bin/python3,bin/pip,share/pacman/keyrings/veyterm.gpg
required_build_tools=make,binutils,autoconf,automake,bison,flex,git,ca-certificates,openssl,zstd,fakeroot
