<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/vey_surface_selected" />
            <stroke android:width="1dp" android:color="@color/vey_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/vey_surface_panel" />
            <stroke android:width="1dp" android:color="@color/vey_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
