<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="TermuxAlertDialogStyle" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <!-- Seen in buttons on alert dialog: -->
        <item name="android:colorAccent">#212121</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Light" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/vey_text_primary</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Dark" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/vey_text_primary</item>
    </style>

    <style name="VeyTermDrawerActionButton" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/vey_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="VeyTermPopupTheme" parent="@android:style/ThemeOverlay.Material.Dark">
        <item name="android:colorAccent">@color/vey_accent</item>
        <item name="android:colorBackground">@color/vey_surface_elevated</item>
        <item name="android:textColorPrimary">@color/vey_text_primary</item>
        <item name="android:textColorSecondary">@color/vey_text_secondary</item>
        <item name="android:popupMenuStyle">@style/VeyTermPopupMenu</item>
    </style>

    <style name="VeyTermPopupMenu" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/veyterm_popup_background</item>
    </style>

    <style name="VeyTermSessionDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/vey_accent</item>
        <item name="android:colorBackground">@color/vey_surface_panel</item>
        <item name="android:textColorPrimary">@color/vey_text_primary</item>
        <item name="android:textColorSecondary">@color/vey_text_secondary</item>
    </style>

</resources>
