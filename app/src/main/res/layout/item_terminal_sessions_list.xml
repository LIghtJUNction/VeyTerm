<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/session_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:background="@drawable/session_row_selector"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <View
        android:id="@+id/session_status_indicator"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:background="@drawable/session_status_stopped" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/session_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:textColor="@color/vey_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/session_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:textColor="@color/vey_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
