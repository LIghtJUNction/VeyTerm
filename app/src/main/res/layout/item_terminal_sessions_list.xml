<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/session_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:background="@drawable/session_row_selector"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/session_status_indicator"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:importantForAccessibility="no"
        android:background="@drawable/session_status_stopped" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/session_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/vey_text_primary"
            android:textSize="14sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/session_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/vey_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/session_actions_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_session_actions"
        android:focusable="false"
        android:padding="14dp"
        android:src="@drawable/ic_more_vert" />
</LinearLayout>
