<?xml version="1.0" encoding="utf-8"?>
<EditText xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/terminal_toolbar_text_input"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/veyterm_text_input_background"
    android:hint="@string/terminal_toolbar_text_input_hint"
    android:imeOptions="actionSend|flagNoFullscreen"
    android:maxLines="1"
    android:inputType="text"
    android:importantForAutofill="no"
    android:minHeight="48dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:textColor="@color/vey_text_primary"
    android:textColorHighlight="@color/vey_surface_selected"
    android:textColorHint="@color/vey_text_secondary"
    android:paddingTop="8dp"
    android:textCursorDrawable="@null"
    android:paddingBottom="8dp"
    tools:ignore="LabelFor" />
