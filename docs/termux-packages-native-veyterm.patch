 termux_step_post_make_install() {
+	# Termux names GNU tools gstrip/gobjcopy/... to coexist with LLVM.
+	# makepkg calls the unprefixed names, including from its tidy helpers.
+	# Give only makepkg a GNU tool path so installing LLVM cannot replace it.
+	local tool
+	mkdir -p "$TERMUX_PREFIX/libexec/makepkg-binutils"
+	for tool in ar addr2line c++filt nm objcopy objdump ranlib readelf size strings strip; do
+		ln -sf "../../bin/g$tool" "$TERMUX_PREFIX/libexec/makepkg-binutils/$tool"
+	done
+	python3 - "$TERMUX_PREFIX/bin/makepkg" "$TERMUX_PREFIX" <<'PY'
+from pathlib import Path
+import sys
+script = Path(sys.argv[1])
+header, separator, body = script.read_text().partition("\n")
+script.write_text(header + separator + f'export PATH="{sys.argv[2]}/libexec/makepkg-binutils:$PATH"\n' + body)
+PY
+
 	mkdir -p $TERMUX_PREFIX/etc/pacman.d
 	install -m644 $TERMUX_PKG_BUILDER_DIR/mirrorlist $TERMUX_PREFIX/etc/pacman.d/mirrorlist
 
