 termux_step_pre_configure() {
 	termux_setup_python_pip
+	python3 - "$TERMUX_APP__DATA_DIR" <<'PY'
+from pathlib import Path
+import sys
+
+for path in Path('.').rglob('*'):
+    if not path.is_file():
+        continue
+    try:
+        text = path.read_text()
+    except UnicodeDecodeError:
+        continue
+    if '/data/data/com.termux' in text:
+        path.write_text(text.replace('/data/data/com.termux', sys.argv[1]))
+PY
 }
 
